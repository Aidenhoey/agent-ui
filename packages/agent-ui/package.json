{
  "name": "@aidenhoey/agent-ui",
  "version": "0.1.0",
  "description": "Protocol-driven React components for agent run timelines and conversations.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "import": "./dist/mock/index.js",
      "default": "./dist/mock/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aidenhoey/agent-ui.git",
    "directory": "packages/agent-ui"
  },
  "homepage": "https://github.com/Aidenhoey/agent-ui#readme",
  "bugs": {
    "url": "https://github.com/Aidenhoey/agent-ui/issues"
  },
  "keywords": ["agent", "ai", "react", "components", "component-library", "typescript", "timeline"],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:dependencies": "node scripts/check-dependencies.mjs",
    "test:tree-shaking": "node scripts/check-tree-shaking.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@tiptap/core": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.2",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
