{
  "name": "agent-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --workspace-concurrency=1 --if-present run build",
    "dev": "pnpm --filter @diribo/agent-ui-portal dev",
    "test": "pnpm --recursive --workspace-concurrency=1 --if-present run test",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 --if-present run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
